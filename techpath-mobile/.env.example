# Copie este arquivo para .env.local e ajuste. Depois reinicie com: npx expo start -c
# ATENÇÃO: variáveis EXPO_PUBLIC_* ficam visíveis no app. Nunca coloque segredos aqui.

# URL do backend (techpath-backend, porta 3000 por padrão). Use UMA das opções:
#   Emulador Android ........ http://10.0.2.2:3000
#   Simulador iOS ........... http://localhost:3000
#   Celular físico (Expo Go)  http://IP-DO-SEU-COMPUTADOR:3000   (mesma rede Wi-Fi)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Modo de login: "simulated" (padrão) = NÃO autentica em servidor; aceita e-mail com "@" e senha de 8+ caracteres,
# só para demonstração. "real" = usa POST /users/login do backend (precisa de EXPO_PUBLIC_API_URL correto).
EXPO_PUBLIC_AUTH_MODE=simulated

# Páginas existentes de Termos e Privacidade (deixe vazio se ainda não existirem;
# o app avisará que a página não está disponível).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
